# Response headers for the hosted site (Cloudflare Pages). Ignored elsewhere.
#
# Cross-origin isolation makes the CPU (WASM) path multithreaded, as in `npm run dev`.
# The Content-Security-Policy is the browser-enforced version of "nothing is uploaded":
# the page may only connect to itself (incl. the podcast proxy), Hugging Face (models),
# jsDelivr (the ONNX runtime) and Apple's podcast search. Change it deliberately.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net https://itunes.apple.com https://plausible.app.promptagency.se; img-src 'self' data: blob: https://*.mzstatic.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()
